# Resend (https://resend.com) API key for the contact form
RESEND_API_KEY=

# Sender must be on a domain verified in Resend, e.g. "Portfolio <contact@yourdomain.com>".
# For testing without a domain, use "onboarding@resend.dev".
CONTACT_FROM_EMAIL=

# Where contact form messages are delivered
CONTACT_TO_EMAIL=
